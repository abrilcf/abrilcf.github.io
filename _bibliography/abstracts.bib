@inproceedings{corona2026MCBK,
  title        = {Generalizable Adverse Safety Event Detection with Locally Deployable Language Models},
  author       = {Corona-Figueroa, Abril and Bahr, Nathan and Bedrick, Steven and Hansen, Matthew and Jiang, Xiaoqian and Guise, Jeanne-Marie},
  year         = {2026},
  month        = {10},
  booktitle= {Mobilizing Computable Biomedical Knowledge},
  preview={mcbk.jpg},
  note         = {Abstract will be published in the Learning Health Systems Journal},
  abstract     = {Background: Adverse safety events (ASEs) are a leading cause of death in the United States. Pediatric ASEs are of special interest because of their high acuity; however, their detection is more difficult due their low prevalence. Moreover, the adjudication of errors requires expert knowledge to accurately discern case context and documented procedures in emergency medical service charts. These limit the scalability of manual review, presenting the opportunity to develop novel approaches that can help with the systematic detection of ASEs while preserving clinical knowledge required for their identification. Methods: We previously developed a framework for the detection of ASEs in pediatric cardiac arrest emergencies. The framework consisted of large language models (LLMs) for information extraction, guided by graph reasoning based on ontologies derived by experts for both medications and procedures. In this work, we evaluate and analyze its implementation feasibility and generalization across various locally deployed LLMs. Using the same knowledge representation, prompts, and processing strategy across models, we examine the relationship between ASE detection performance, model parameter count, inference time, and model reasoning capabilities. Results show insights into the potential tradeoffs between detection performance and computational efficiency, which are informative for prior implementation assessment within institution environments. Results and Discussion: Contrary to expectation, across evaluated models, larger LLMs were not necessarily associated with better detection performance of ASEs. For example, DeepSeek-R1 32B and its 8B version achieved similar performance. On the other hand, several smaller models achieved comparable performance in similar inference times, indicating that the incorporation of expert knowledge into the graph reasoning framework reduces the dependence on model scale. Models that have reasoning capabilities were able to achieve higher detection performance but required longer inference times. Overall, we observed that short and clear prompts are effective across models as they allow more model capacity to be used for context reasoning. Furthermore, chunking strategies provided a controlled inference setting regardless of context windows and reasoning capacity. Conclusion: Our work shows preliminary data that the proposed ASE detection framework is agnostic to LLM selection, further enabling its use when limited computational resources are available. The combination of expert knowledge as graphs, efficient prompting and a chunking strategy greatly improves the portability of the framework and overall reproducibility of results, enabling its potential implementation for safety surveillance.}
}

@inproceedings{corona2026AcademyHealth,
  title        = {Urban and Rural Differences in Pediatric Mortality: A National Analysis of EMS Records},
  author       = {Corona-Figueroa, Abril and Huynh, Trang and Hansen, Matthew and Guise, Jeanne-Marie},
  year         = {2026},
  month        = {6},
  booktitle = {AcademyHealth Annual Research Meeting},
  preview={academyhealth.png},
  note         = {Accepted conference abstract},
  abstract     = {Research Objective: Recent evidence indicates that children living in rural areas experience higher mortality than those in urban settings, often attributed to unintentional injuries, though the underlying causes are unclear. This study aimed to examine pediatric mortality differences among EMS patients by scene location. Study Design: We conducted a retrospective analysis of pediatric (<18 years) 9-1-1 encounters from the 2018-2023 ESO Data Collaborative research datasets. We standardized records and compared mortality across urbanicity classifications to identify vulnerable populations and geographic differences. Population Studied: Over the five-year period, there were 3,756,061 EMS encounters for children aged 0–17 years; 3,119,180 urban encounters (83%), 527,352 rural (14%), and 96,809 (3%) super-rural. Principal Findings: Super-rural pediatric mortality was nearly twice that of urban areas (RR = 1.97, 95% CI 1.79–2.15) and 37% higher than rural areas (RR = 1.37, 95% CI 1.23–1.51), despite most deaths occurring in urban settings (2.6 per 1,000 EMS encounters vs. 3.7 rural and 5 super-rural per 1,000). Mortality was higher in males than females (RR = 1.59, 95% CI 1.53–1.66). Although adolescents (13–17 years) accounted for the largest share of encounters (41.8%), mortality was highest among neonates (RR = 5.13, 95% CI 4.82–5.46) and infants (RR = 3.24, 95% CI 2.93–3.58), with 17-year-olds showing lower rates (3 per 1,000). Among 10,508 pediatric deaths, cardiac arrest was the most common primary impression (42.5%), with infant asphyxia responsible for the largest number of cardiac-arrest deaths (n = 304) and trauma predominating among adolescents. In deaths with documented timing (45%), pre-EMS deaths were proportionally higher in rural (21%) and super-rural areas (17%) than in urban regions (3.6%), whereas urban deaths more often occurred in the ED (23%). Neonates and infants comprised the largest pre-EMS death group across geographies, followed by 17-year-olds. Trauma was the leading recorded etiology in all settings; exceeding urban levels by at least 15% in rural and super-rural regions, followed by presumed cardiac and respiratory/asphyxia causes. Firearm injuries predominated in urban areas, motor vehicle crashes in rural and super-rural regions, and intentional self-harm was least frequent in super-rural areas. Median EMS response times were shortest in urban areas (6.6 min, IQR 4.6–9.5), slightly longer in rural areas (7.2 min, IQR 4.7–11.2), and in super-rural regions (7 min, IQR 4.5–13). Conclusions: Children in rural and super-rural areas had higher mortality across age groups and etiologies, with neonates and infants at greatest risk. Implication for Policy or Practice Neonates and infants are at highest risk for mortality across settings. They are also groups with unique equipment sizing and medication dosing needs. These findings suggest that efforts to ensure that rural communities and services have the resources and support to be prepared for pediatric emergencies are justified.}
}

@inproceedings{corona2026PAS,
  title        = {Development and pilot testing of a linear cognitive app to support EMS teams in neonatal and pediatric cardiac arrest resuscitations},
  author       = {Corona-Figueroa, Abril and Guise, Jeanne-Marie},
  year         = {2026},
  month        = {4},
  booktitle = {Pediatric Academic Societies Meeting},
  preview={pas2026.jpg},
  note         = {Accepted conference abstract},
  abstract     = {Background: Pediatric cardiac arrest is a leading cause of child mortality. Most events occur out-of-hospital, where Emergency Medical Services (EMS) provide critical care. Because neonatal and pediatric cardiac arrests are relatively rare, EMS providers have limited exposure and may face higher cognitive demands. Prior studies found that non-linear cognitive aids were associated with delays in cardiac arrest care. Objective: To develop and test the feasibility of a linear cognitive app (RESCUER) intended to support EMS personnel in responding to neonatal and pediatric out-of-hospital cardiac arrest (POHCA). Design/Methods: Development and pilot testing of a linear cognitive app that combines NRP and PALS step-by-step algorithmic guidance with age and weight-based pediatric dosing of medications and sizing of equipment. Its linear design provides sequential real-time instructions during resuscitations. We also developed voice-guidance that functions much like AED voice prompts, to allow all team members to stay on track. We conducted preliminary feasibility testing with EMS teams in preparation for a larger planned RCT. Results: Preliminary tests with rural and urban EMS teams found that users were able to easily understand how to use the app with very little orientation (<5 minutes). Users were also able to use the app in simulated cardiac arrest settings without major disruption. However, in one instance, the person holding the app got so enthralled with the simulation that they forgot to start the app for quite a while. By the time they started it, given its linear nature, the instructions were behind the team. While one test among a team consisting of highly experienced EMS trainers found the linear nature frustrating stating that they were thinking many steps ahead, a rural team consisting of newly minted EMTs reported that the app was highly valuable. We also identified one save where a team proceeded with the wrong treatments until the app gave instructions for the correct steps. Voice commands also received mixed results with experienced teams finding it distracting and less experienced rural teams finding it calming in the setting of events which they find highly stressful. Conclusions: Findings from our pilot suggest that using an app to guide clinical care for POHCA, is likely feasible in a variety of settings.  It also provided interesting hypotheses regarding the role of experience with linear design and voice prompts.  We have started a randomized control trial to evaluate the app in rural and urban EMS practices (NCT06768099 clinical trials.gov).}
}